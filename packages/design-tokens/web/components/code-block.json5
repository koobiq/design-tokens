{
    'code-block': {
        light: {
            filled: {
                actionbar: {
                    'fade-gradient': {
                        $value: 'linear-gradient(90deg, transparent, {light.background.bg-secondary})',
                    },
                },
                collapse: {
                    collapsed: {
                        background: {
                            $value: 'linear-gradient(180deg, transparent 0%, {light.background.bg-secondary} 100%)',
                        },
                    },
                },
            },
            outline: {
                actionbar: {
                    'fade-gradient': {
                        $value: 'linear-gradient(90deg, transparent, {light.background.card})',
                    },
                },
                collapse: {
                    collapsed: {
                        background: {
                            $value: 'linear-gradient(180deg, transparent 0%, {light.background.card} 100%)',
                        },
                    },
                },
            },
            hljs: {
                $type: 'color',
                addition: {
                    background: {
                        $value: '{plt.greenA.2}',
                        $description: 'Background for an added or changed line.',
                    },
                    color: {
                        $value: '{plt.greenA.16}',
                        $description: 'Text color for an added or changed line.',
                    },
                },
                'built-in': {
                    color: {
                        $value: '{plt.blueA.16}',
                        $description: 'Built-in or library object, such as a constant, class, or function.',
                    },
                },
                comment: {
                    color: {
                        $value: '{plt.slateA.16}',
                        $description: 'Comments.',
                    },
                },
                deletion: {
                    background: {
                        $value: '{plt.redA.2}',
                        $description: 'Background for a deleted line.',
                    },
                    color: {
                        $value: '{plt.redA.16}',
                        $description: 'Text color for a deleted line.',
                    },
                },
                'line-numbers': {
                    color: {
                        $value: '{light.foreground.contrast-secondary}',
                        $description: 'Line numbers in the code block.',
                    },
                },
                literal: {
                    color: {
                        $value: '{plt.purpleA.16}',
                        $description: 'Special identifier for a built-in value, such as true, false, or null.',
                    },
                },
                meta: {
                    color: {
                        $value: '{plt.blueA.16}',
                        $description: 'Flags, modifiers, annotations, processing instructions, or preprocessor directives.',
                    },
                },
                'meta string': {
                    color: {
                        $value: '{plt.blueA.16}',
                        $description: 'String inside a meta block.',
                    },
                },
                name: {
                    color: {
                        $value: '{plt.blueA.16}',
                        $description: 'Name of an XML tag or the first word in an s-expression.',
                    },
                },
                number: {
                    color: {
                        $value: '{plt.purpleA.16}',
                        $description: 'Number, including units and modifiers.',
                    },
                },
                regexp: {
                    color: {
                        $value: '{plt.greenA.16}',
                        $description: 'Literal regular expression.',
                    },
                },
                'selector-tag': {
                    color: {
                        $value: '{plt.blueA.16}',
                        $description: 'Tag selector.',
                    },
                },
                string: {
                    color: {
                        $value: '{plt.greenA.16}',
                        $description: 'Literal string or character.',
                    },
                },
                symbol: {
                    color: {
                        $value: '{plt.blueA.16}',
                        $description: 'Symbolic constant, interned string, or goto label.',
                    },
                },
                title: {
                    color: {
                        $value: '{plt.blueA.16}',
                        $description: 'Name of a class or a function.',
                    },
                },
            },
        },
        dark: {
            filled: {
                actionbar: {
                    'fade-gradient': {
                        $value: 'linear-gradient(90deg, transparent, {dark.background.bg-secondary})',
                    },
                },
                collapse: {
                    collapsed: {
                        background: {
                            $value: 'linear-gradient(180deg, transparent 0%, {dark.background.bg-secondary} 100%)',
                        },
                    },
                },
            },
            outline: {
                actionbar: {
                    'fade-gradient': {
                        $value: 'linear-gradient(90deg, transparent, {dark.background.card})',
                    },
                },
                collapse: {
                    collapsed: {
                        background: {
                            $value: 'linear-gradient(180deg, transparent 0%, {dark.background.card} 100%)',
                        },
                    },
                },
            },
            hljs: {
                $type: 'color',
                addition: {
                    background: {
                        $value: '{plt.darkGreenA.5}',
                        $description: 'Background for an added or changed line.',
                    },
                    color: {
                        $value: '{plt.darkGreenA.14}',
                        $description: 'Text color for an added or changed line.',
                    },
                },
                'built-in': {
                    color: {
                        $value: '{plt.darkBlueA.14}',
                        $description: 'Built-in or library object, such as a constant, class, or function.',
                    },
                },
                comment: {
                    color: {
                        $value: '{plt.darkSlateA.14}',
                        $description: 'Comments.',
                    },
                },
                deletion: {
                    background: {
                        $value: '{plt.darkRedA.5}',
                        $description: 'Background for a deleted line.',
                    },
                    color: {
                        $value: '{plt.darkRedA.14}',
                        $description: 'Text color for a deleted line.',
                    },
                },
                'line-numbers': {
                    color: {
                        $value: '{dark.foreground.contrast-secondary}',
                        $description: 'Line numbers in the code block.',
                    },
                },
                literal: {
                    color: {
                        $value: '{plt.darkPurpleA.14}',
                        $description: 'Special identifier for a built-in value, such as true, false, or null.',
                    },
                },
                meta: {
                    color: {
                        $value: '{plt.darkBlueA.14}',
                        $description: 'Flags, modifiers, annotations, processing instructions, or preprocessor directives.',
                    },
                },
                'meta string': {
                    color: {
                        $value: '{plt.darkBlueA.14}',
                        $description: 'String inside a meta block.',
                    },
                },
                name: {
                    color: {
                        $value: '{plt.darkBlueA.14}',
                        $description: 'Name of an XML tag or the first word in an s-expression.',
                    },
                },
                number: {
                    color: {
                        $value: '{plt.darkPurpleA.14}',
                        $description: 'Number, including units and modifiers.',
                    },
                },
                regexp: {
                    color: {
                        $value: '{plt.darkGreenA.14}',
                        $description: 'Literal regular expression.',
                    },
                },
                'selector-tag': {
                    color: {
                        $value: '{plt.darkBlueA.14}',
                        $description: 'Tag selector.',
                    },
                },
                string: {
                    color: {
                        $value: '{plt.darkGreenA.14}',
                        $description: 'Literal string or character.',
                    },
                },
                symbol: {
                    color: {
                        $value: '{plt.darkBlueA.14}',
                        $description: 'Symbolic constant, interned string, or goto label.',
                    },
                },
                title: {
                    color: {
                        $value: '{plt.darkBlueA.14}',
                        $description: 'Name of a class or a function.',
                    },
                },
            },
        },
    },
}
