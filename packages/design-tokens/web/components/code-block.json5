                    }
                }
            },
            hljs: {
                addition: {
                    background: { value: '{semantic.darkSuccess.20}' },
                    color: { value: '{semantic.darkSuccess.9}' }
                },
                attr: { background: { value: '' }, color: { value: '' } },
                attribute: { background: { value: '' }, color: { value: '' } },
                built_in: { background: { value: '' }, color: { value: '' } },
                bullet: { background: { value: '' }, color: { value: '' } },
                'char.escape': { background: { value: '' }, color: { value: '' } },
                class: { background: { value: '' }, color: { value: '' } },
                code: { background: { value: '' }, color: { value: '' } },
                comment: {
                    background: { value: '' },
                    color: { value: '{semantic.darkContrast.13}' }
                },
                deletion: {
                    background: { value: '{semantic.darkError.20}' },
                    color: { value: '{semantic.darkError.9}' }
                },
                doctag: { background: { value: '' }, color: { value: '' } },
                emphasis: { background: { value: '' }, color: { value: '' } },
                formula: { background: { value: '' }, color: { value: '' } },
                function: { background: { value: '' }, color: { value: '' } },
                keyword: { background: { value: '' }, color: { value: '' } },
                'line-numbers': {
