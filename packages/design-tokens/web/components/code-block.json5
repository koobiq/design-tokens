{
    'code-block': {
        light: {
            filled: {
                actionbar: {
                    'fade-gradient': {
                        $value: 'linear-gradient(90deg, transparent, {light.background.bg-secondary})',
                    },
                },
                collapse: {
                    collapsed: {
                        background: {
                            $value: 'linear-gradient(180deg, transparent 0%, {light.background.bg-secondary} 100%)',
                        },
                    },
                },
            },
            outline: {
                actionbar: {
                    'fade-gradient': {
                        $value: 'linear-gradient(90deg, transparent, {light.background.card})',
                    },
                },
                collapse: {
                    collapsed: {
                        background: {
                            $value: 'linear-gradient(180deg, transparent 0%, {light.background.card} 100%)',
                        },
                    },
                },
            },
            hljs: {
                $type: 'color',
                addition: {
                    background: {
                        $value: '{semantic.success.1}',
                    },
                    color: {
                        $value: '{semantic.success.17}',
                    },
                },
                comment: {
                    color: {
                        $value: '{semantic.contrast.13}',
                    },
                },
                deletion: {
                    background: {
                        $value: '{semantic.error.2}',
                    },
                    color: {
                        $value: '{semantic.error.17}',
                    },
                },
                'line-numbers': {
                    color: {
                        $value: '{light.foreground.contrast-secondary}',
                    },
                },
                literal: {
                    color: {
                        $value: '{semantic.visited.18}',
                    },
                },
                meta: {
                    color: {
                        $value: '{semantic.theme.18}',
                    },
                },
                'meta string': {
                    color: {
                        $value: '{semantic.theme.18}',
                    },
                },
                name: {
                    color: {
                        $value: '{semantic.theme.18}',
                    },
                },
                number: {
                    color: {
                        $value: '{semantic.visited.18}',
                    },
                },
                regexp: {
                    color: {
                        $value: '{semantic.success.17}',
                    },
                },
                'selector-tag': {
                    color: {
                        $value: '{semantic.theme.18}',
                    },
                },
                string: {
                    color: {
                        $value: '{semantic.success.17}',
                    },
                },
                symbol: {
                    color: {
                        $value: '{semantic.theme.18}',
                    },
                },
                title: {
                    color: {
                        $value: '{semantic.theme.18}',
                    },
                },
            },
        },
        dark: {
            filled: {
                actionbar: {
                    'fade-gradient': {
                        $value: 'linear-gradient(90deg, transparent, {dark.background.bg-secondary})',
                    },
                },
                collapse: {
                    collapsed: {
                        background: {
                            $value: 'linear-gradient(180deg, transparent 0%, {dark.background.bg-secondary} 100%)',
                        },
                    },
                },
            },
            outline: {
                actionbar: {
                    'fade-gradient': {
                        $value: 'linear-gradient(90deg, transparent, {dark.background.card})',
                    },
                },
                collapse: {
                    collapsed: {
                        background: {
                            $value: 'linear-gradient(180deg, transparent 0%, {dark.background.card} 100%)',
                        },
                    },
                },
            },
            hljs: {
                $type: 'color',
                addition: {
                    background: {
                        $value: '{semantic.darkSuccess.20}',
                    },
                    color: {
                        $value: '{semantic.darkSuccess.9}',
                    },
                },
                comment: {
                    color: {
                        $value: '{semantic.darkContrast.13}',
                    },
                },
                deletion: {
                    background: {
                        $value: '{semantic.darkError.20}',
                    },
                    color: {
                        $value: '{semantic.darkError.9}',
                    },
                },
                'line-numbers': {
                    color: {
                        $value: '{dark.foreground.contrast-secondary}',
                    },
                },
                literal: {
                    color: {
                        $value: '{semantic.darkVisited.12}',
                    },
                },
                meta: {
                    color: {
                        $value: '{semantic.darkTheme.14}',
                    },
                },
                'meta string': {
                    color: {
                        $value: '{semantic.darkTheme.14}',
                    },
                },
                name: {
                    color: {
                        $value: '{semantic.darkTheme.14}',
                    },
                },
                number: {
                    color: {
                        $value: '{semantic.darkVisited.12}',
                    },
                },
                regexp: {
                    color: {
                        $value: '{semantic.darkSuccess.14}',
                    },
                },
                'selector-tag': {
                    color: {
                        $value: '{semantic.darkTheme.14}',
                    },
                },
                string: {
                    color: {
                        $value: '{semantic.darkSuccess.14}',
                    },
                },
                symbol: {
                    color: {
                        $value: '{semantic.darkTheme.14}',
                    },
                },
                title: {
                    color: {
                        $value: '{semantic.darkTheme.14}',
                    },
                },
            },
        },
    },
}
