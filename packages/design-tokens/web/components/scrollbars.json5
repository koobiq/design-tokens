{
    scrollbar: {
        size: {
            $type: 'dimension',
            track: {
                dimension: {
                    $value: '{size.l}',
                    $description: 'Width of a vertical scrollbar track, and height of a horizontal one.',
                },
                padding: {
                    vertical: {
                        $value: '{size.3xs}',
                        $description: 'Gap between the thumb and the two ends of a vertical track.',
                    },
                    horizontal: {
                        $value: '{size.3xs}',
                        $description: 'Gap between the thumb and the sides of the track.',
                    },
                },
            },
            thumb: {
                width: {
                    $value: '{size.s}',
                    $description: 'Thickness of the draggable thumb.',
                },
                'min-size': {
                    $value: '{size.xl}',
                    $description: 'Shortest the thumb is allowed to get on very long content, so it stays easy to grab.',
                },
                border: {
                    radius: {
                        $value: '{size.s}',
                        $description: 'Corner radius of the thumb.',
                    },
                },
            },
        },
        light: {
            $type: 'color',
            thumb: {
                default: {
                    background: {
                        $value: '{semantic.contrastA.3}',
                        $description: 'Thumb fill in the default state — not hovered, not being dragged.',
                    },
                },
                hover: {
                    background: {
                        $value: '{semantic.contrastA.4}',
                        $description: 'Thumb fill while the pointer is over the scrollbar.',
                    },
                },
                active: {
                    background: {
                        $value: '{semantic.contrastA.5}',
                        $description: 'Thumb fill while the thumb is being dragged.',
                    },
                },
                disabled: {
                    background: {
                        $value: '{light.states.icon.disabled}',
                        $description: 'Thumb fill when the scrollable area is disabled.',
                    },
                },
            },
            track: {
                default: {
                    border: {
                        $value: 'transparent',
                        $description: 'Track border in the default state. Transparent, so the track reads as part of the surface.',
                    },
                    background: {
                        $value: 'transparent',
                        $description: 'Track fill in the default state. Transparent, so content shows through.',
                    },
                },
                hover: {
                    border: {
                        $value: 'transparent',
                        $description: 'Track border while the pointer is over the scrollbar.',
                    },
                    background: {
                        $value: 'transparent',
                        $description: 'Track fill while the pointer is over the scrollbar.',
                    },
                },
                active: {
                    border: {
                        $value: 'transparent',
                        $description: 'Track border while the thumb is being dragged.',
                    },
                    background: {
                        $value: 'transparent',
                        $description: 'Track fill while the thumb is being dragged.',
                    },
                },
            },
        },
        dark: {
            $type: 'color',
            thumb: {
                default: {
                    background: {
                        $value: '{semantic.darkContrastA.9}',
                        $description: 'Thumb fill in the default state — not hovered, not being dragged.',
                    },
                },
                hover: {
                    background: {
                        $value: '{semantic.darkContrastA.10}',
                        $description: 'Thumb fill while the pointer is over the scrollbar.',
                    },
                },
                active: {
                    background: {
                        $value: '{semantic.darkContrastA.11}',
                        $description: 'Thumb fill while the thumb is being dragged.',
                    },
                },
                disabled: {
                    background: {
                        $value: '{dark.states.icon.disabled}',
                        $description: 'Thumb fill when the scrollable area is disabled.',
                    },
                },
            },
            track: {
                default: {
                    border: {
                        $value: 'transparent',
                        $description: 'Track border in the default state. Transparent, so the track reads as part of the surface.',
                    },
                    background: {
                        $value: 'transparent',
                        $description: 'Track fill in the default state. Transparent, so content shows through.',
                    },
                },
                hover: {
                    border: {
                        $value: 'transparent',
                        $description: 'Track border while the pointer is over the scrollbar.',
                    },
                    background: {
                        $value: 'transparent',
                        $description: 'Track fill while the pointer is over the scrollbar.',
                    },
                },
                active: {
                    border: {
                        $value: 'transparent',
                        $description: 'Track border while the thumb is being dragged.',
                    },
                    background: {
                        $value: 'transparent',
                        $description: 'Track fill while the thumb is being dragged.',
                    },
                },
            },
        },
    },
}
