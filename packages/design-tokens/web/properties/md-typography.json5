{
    'md-typography': {
        $type: 'typography',
        'md-h1': {
            $value: '{typography.display-compact}',
        },
        // Not display-compact: two steps smaller and bold, so it has to be written out.
        'md-h2': {
            $value: {
                fontSize: '24px',
                lineHeight: '32px',
                letterSpacing: 'normal',
                fontWeight: 700,
                fontFamily: '{typography.display-compact.fontFamily}',
                textTransform: '{typography.display-compact.textTransform}',
                fontFeatureSettings: '{typography.display-compact.fontFeatureSettings}',
            },
        },
        'md-h3': {
            $value: '{typography.title}',
        },
        // subheading, but bold (700 against its 600).
        'md-h4': {
            $value: {
                fontSize: '{typography.subheading.fontSize}',
                lineHeight: '{typography.subheading.lineHeight}',
                letterSpacing: '{typography.subheading.letterSpacing}',
                fontWeight: 700,
                fontFamily: '{typography.subheading.fontFamily}',
                textTransform: '{typography.subheading.textTransform}',
                fontFeatureSettings: '{typography.subheading.fontFeatureSettings}',
            },
        },
        // text-big-strong, but bold (700 against its 600).
        'md-h5': {
            $value: {
                fontSize: '{typography.text-big-strong.fontSize}',
                lineHeight: '{typography.text-big-strong.lineHeight}',
                letterSpacing: '{typography.text-big-strong.letterSpacing}',
                fontWeight: 700,
                fontFamily: '{typography.text-big-strong.fontFamily}',
                textTransform: '{typography.text-big-strong.textTransform}',
                fontFeatureSettings: '{typography.text-big-strong.fontFeatureSettings}',
            },
        },
        'md-h6': {
            $value: '{typography.caps-normal-strong}',
        },
        'md-body': {
            $value: '{typography.text-big}',
        },
        'md-body-mono': {
            $value: '{typography.mono-big}',
        },
        'md-inline-code': {
            $value: '{typography.mono-normal}',
        },
        'md-inline-code-as-link': {
            $value: '{typography.mono-normal-medium}',
        },
        'md-caption': {
            $value: '{typography.text-normal}',
        },
        'md-table-cell': {
            $value: '{typography.tabular-big}',
        },
        'md-table-header': {
            $value: '{typography.tabular-normal}',
        },
    },
}
