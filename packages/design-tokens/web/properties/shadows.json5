{
    shadow: {
        $description: 'Mirrors the Figma Shadow collection. Flat shadows (card, popup, overlay) fall down and have no parameter tokens: their values are written directly in the composites shadow.light|dark.<name>, one object per layer (outline, key, ambient). Shadows that fall in several directions (overflow-*) have offset (along the main axis: down or right), offset-neg (the same distance the opposite way: up or left) and cross (the additional axis, 0 by default) per layer; offset-neg is a value of its own, mirrored from Figma where variables cannot negate, so keep each pair equal. The final per-side x, y, blur, spread and color of Figma are the attributes of the layer objects in the $value array of shadow.light|dark.<shadow>-<side> (one object per layer: outline, key, ambient), each pointing at the layer variables above. Colors are under light.shadow / dark.shadow.',
        'overflow-compact': {
            $type: 'dimension',
            base: {
                outline: {
                    offset: {
                        $value: '1px',
                    },
                    'offset-neg': {
                        $value: '-1px',
                    },
                    cross: {
                        $value: '0px',
                    },
                    blur: {
                        $value: '0px',
                    },
                    spread: {
                        $value: '0px',
                    },
                },
                key: {
                    offset: {
                        $value: '0px',
                    },
                    'offset-neg': {
                        $value: '0px',
                    },
                    cross: {
                        $value: '0px',
                    },
                    blur: {
                        $value: '0px',
                    },
                    spread: {
                        $value: '0px',
                    },
                },
                ambient: {
                    offset: {
                        $value: '0px',
                    },
                    'offset-neg': {
                        $value: '0px',
                    },
                    cross: {
                        $value: '0px',
                    },
                    blur: {
                        $value: '0px',
                    },
                    spread: {
                        $value: '0px',
                    },
                },
            },
        },
        'overflow-normal': {
            $type: 'dimension',
            base: {
                outline: {
                    offset: {
                        $value: '1px',
                    },
                    'offset-neg': {
                        $value: '-1px',
                    },
                    cross: {
                        $value: '0px',
                    },
                    blur: {
                        $value: '0px',
                    },
                    spread: {
                        $value: '0px',
                    },
                },
                key: {
                    offset: {
                        $value: '9px',
                    },
                    'offset-neg': {
                        $value: '-9px',
                    },
                    cross: {
                        $value: '0px',
                    },
                    blur: {
                        $value: '8px',
                    },
                    spread: {
                        $value: '-12px',
                    },
                },
                ambient: {
                    offset: {
                        $value: '0px',
                    },
                    'offset-neg': {
                        $value: '0px',
                    },
                    cross: {
                        $value: '0px',
                    },
                    blur: {
                        $value: '0px',
                    },
                    spread: {
                        $value: '0px',
                    },
                },
            },
        },
        light: {
            'overflow-compact-top': {
                $type: 'shadow',
                $value: [
                    {
                        offsetX: '{shadow.overflow-compact.base.outline.cross}',
                        offsetY: '{shadow.overflow-compact.base.outline.offset-neg}',
                        blur: '{shadow.overflow-compact.base.outline.blur}',
                        spread: '{shadow.overflow-compact.base.outline.spread}',
                        color: '{light.shadow.overflow-compact.base.outline.color}',
                    },
                    {
                        offsetX: '{shadow.overflow-compact.base.key.cross}',
                        offsetY: '{shadow.overflow-compact.base.key.offset-neg}',
                        blur: '{shadow.overflow-compact.base.key.blur}',
                        spread: '{shadow.overflow-compact.base.key.spread}',
                        color: '{light.shadow.overflow-compact.base.key.color}',
                    },
                    {
                        offsetX: '{shadow.overflow-compact.base.ambient.cross}',
                        offsetY: '{shadow.overflow-compact.base.ambient.offset-neg}',
                        blur: '{shadow.overflow-compact.base.ambient.blur}',
                        spread: '{shadow.overflow-compact.base.ambient.spread}',
                        color: '{light.shadow.overflow-compact.base.ambient.color}',
                    },
                ],
                $description: 'Subtle overflow shadow for low-elevation elements.',
