                                offsetY: '{shadow.light.overflow.normal.base.ambient.offset}',
                                blur: '{shadow.light.overflow.normal.base.ambient.blur}',
                                spread: '{shadow.light.overflow.normal.base.ambient.spread}',
                                color: '{shadow.light.overflow.normal.base.ambient.color}',
                            },
                        ],
                    },
                    left: {
                        $type: 'shadow',
                        $value: [
                            {
                                offsetX: '{shadow.light.overflow.normal.base.outline.offset-neg}',
                                offsetY: '{shadow.light.overflow.normal.base.outline.cross}',
                                blur: '{shadow.light.overflow.normal.base.outline.blur}',
                                spread: '{shadow.light.overflow.normal.base.outline.spread}',
                                color: '{shadow.light.overflow.normal.base.outline.color}',
                            },
                            {
                                offsetX: '{shadow.light.overflow.normal.base.key.offset-neg}',
                                offsetY: '{shadow.light.overflow.normal.base.key.cross}',
                                blur: '{shadow.light.overflow.normal.base.key.blur}',
                                spread: '{shadow.light.overflow.normal.base.key.spread}',
                                color: '{shadow.light.overflow.normal.base.key.color}',
                            },
                            {
                                offsetX: '{shadow.light.overflow.normal.base.ambient.offset-neg}',
                                offsetY: '{shadow.light.overflow.normal.base.ambient.cross}',
                                blur: '{shadow.light.overflow.normal.base.ambient.blur}',
                                spread: '{shadow.light.overflow.normal.base.ambient.spread}',
                                color: '{shadow.light.overflow.normal.base.ambient.color}',
                            },
                        ],
                    },
                },
            },
            card: {
                $type: 'shadow',
                $value: [
                    {
                        offsetX: '0px',
                        offsetY: '0px',
                        blur: '0px',
                        spread: '1px',
                        color: '{shadow.light.outline}',
                    },
                    {
                        offsetX: '0px',
                        offsetY: '1px',
                        blur: '6px',
                        spread: '0px',
                        color: '{shadow.light.key}',
                    },
                    {
                        offsetX: '0px',
                        offsetY: '1px',
                        blur: '6px',
                        spread: '0px',
                        color: '{shadow.light.ambient}',
                    },
                ],
                $description: 'Elevated card.',
            },
            popup: {
                $type: 'shadow',
                $value: [
                    {
                        offsetX: '0px',
                        offsetY: '0px',
                        blur: '0px',
                        spread: '1px',
                        color: '{shadow.light.outline}',
                    },
                    {
                        offsetX: '0px',
                        offsetY: '2px',
                        blur: '8px',
                        spread: '0px',
                        color: '{shadow.light.key}',
                    },
                    {
                        offsetX: '0px',
                        offsetY: '3px',
                        blur: '8px',
                        spread: '0px',
                        color: '{shadow.light.ambient}',
                    },
                ],
                $description: 'Dropdowns, popovers, tooltips.',
            },
            overlay: {
                $type: 'shadow',
                $value: [
                    {
                        offsetX: '0px',
                        offsetY: '0px',
                        blur: '0px',
                        spread: '1px',
                        color: '{shadow.light.outline}',
                    },
                    {
                        offsetX: '0px',
                        offsetY: '3px',
                        blur: '16px',
                        spread: '0px',
                        color: '{shadow.light.key}',
                    },
                    {
                        offsetX: '0px',
                        offsetY: '4px',
                        blur: '32px',
                        spread: '0px',
                        color: '{shadow.light.ambient}',
                    },
                ],
                $description: 'Modals, dialogs.',
            },
        },
