            $type: 'typography',
            $value: {
                fontSize: { value: 14, unit: 'px' },
                lineHeight: { value: 20, unit: 'px' },
                letterSpacing: { value: -0.084, unit: 'px' },
                fontWeight: 'normal',
                fontFamily: '{font.family.base}',
                textTransform: 'initial',
                fontFeatureSettings: '"calt", "kern", "liga", "ss01", "ss04", "zero"',
            },
        },
        'text-normal-medium': {
            $type: 'typography',
