            $type: 'typography',
            $value: {
                fontSize: { value: 16, unit: 'px' },
                lineHeight: { value: 24, unit: 'px' },
                letterSpacing: { value: 0, unit: 'px' },
                fontWeight: 'normal',
                fontFamily: '{font.family.mono}',
                textTransform: 'initial',
                fontFeatureSettings: 'initial',
            },
        },
        'mono-big-strong': {
            $type: 'typography',
            $value: {
                fontSize: { value: 16, unit: 'px' },
                lineHeight: { value: 24, unit: 'px' },
                letterSpacing: { value: 0, unit: 'px' },
                fontWeight: 700,
                fontFamily: '{font.family.mono}',
                textTransform: 'initial',
                fontFeatureSettings: 'initial',
            },
        },
        'mono-normal': {
            $type: 'typography',
            $value: {
                fontSize: { value: 14, unit: 'px' },
                lineHeight: { value: 20, unit: 'px' },
                letterSpacing: { value: 0, unit: 'px' },
                fontWeight: 'normal',
                fontFamily: '{font.family.mono}',
                textTransform: 'initial',
                fontFeatureSettings: 'initial',
            },
        },
        'mono-normal-medium': {
            $type: 'typography',
            $value: {
                fontSize: { value: 14, unit: 'px' },
                lineHeight: { value: 20, unit: 'px' },
                letterSpacing: { value: 0, unit: 'px' },
                fontWeight: 600,
                fontFamily: '{font.family.mono}',
                textTransform: 'initial',
                fontFeatureSettings: 'initial',
            },
        },
        'mono-normal-strong': {
            $type: 'typography',
            $value: {
                fontSize: { value: 14, unit: 'px' },
                lineHeight: { value: 20, unit: 'px' },
                letterSpacing: { value: 0, unit: 'px' },
                fontWeight: 700,
                fontFamily: '{font.family.mono}',
                textTransform: 'initial',
                fontFeatureSettings: 'initial',
            },
        },
        'mono-compact': {
            $type: 'typography',
            $value: {
                fontSize: { value: 12, unit: 'px' },
                lineHeight: { value: 16, unit: 'px' },
                letterSpacing: { value: 0, unit: 'px' },
                fontWeight: 'normal',
                fontFamily: '{font.family.mono}',
                textTransform: 'initial',
                fontFeatureSettings: 'initial',
            },
        },
        'mono-compact-strong': {
            $type: 'typography',
            $value: {
                fontSize: { value: 12, unit: 'px' },
                lineHeight: { value: 16, unit: 'px' },
                letterSpacing: { value: 0, unit: 'px' },
                fontWeight: 700,
                fontFamily: '{font.family.mono}',
                textTransform: 'initial',
                fontFeatureSettings: 'initial',
            },
        },
        'mono-codeblock': {
            $type: 'typography',
            $value: {
                fontSize: { value: 14, unit: 'px' },
                lineHeight: { value: 20, unit: 'px' },
                letterSpacing: { value: 0, unit: 'px' },
                fontWeight: 'normal',
                fontFamily: '{font.family.mono}',
                textTransform: 'initial',
                fontFeatureSettings: 'initial',
            },
        },
        'tabular-big': {
            $type: 'typography',
            $value: {
                fontSize: { value: 16, unit: 'px' },
                lineHeight: { value: 24, unit: 'px' },
                letterSpacing: { value: 0, unit: 'px' },
                fontWeight: 'normal',
                fontFamily: '{font.family.base}',
                textTransform: 'initial',
                fontFeatureSettings: '"calt", "ss01", "ss04", "tnum", "zero"',
            },
        },
        'tabular-big-strong': {
            $type: 'typography',
            $value: {
                fontSize: { value: 16, unit: 'px' },
                lineHeight: { value: 24, unit: 'px' },
                letterSpacing: { value: 0, unit: 'px' },
                fontWeight: 600,
                fontFamily: '{font.family.base}',
                textTransform: 'initial',
                fontFeatureSettings: '"calt", "ss01", "ss04", "tnum", "zero"',
            },
        },
        'tabular-normal': {
            $type: 'typography',
            $value: {
                fontSize: { value: 14, unit: 'px' },
                lineHeight: { value: 20, unit: 'px' },
                letterSpacing: { value: -0.084, unit: 'px' },
                fontWeight: 'normal',
                fontFamily: '{font.family.base}',
                textTransform: 'initial',
                fontFeatureSettings: '"calt", "ss01", "ss04", "tnum", "zero"',
            },
        },
        'tabular-normal-strong': {
            $type: 'typography',
            $value: {
                fontSize: { value: 14, unit: 'px' },
                lineHeight: { value: 20, unit: 'px' },
                letterSpacing: { value: -0.084, unit: 'px' },
                fontWeight: 600,
                fontFamily: '{font.family.base}',
                textTransform: 'initial',
                fontFeatureSettings: '"calt", "ss01", "ss04", "tnum", "zero"',
            },
        },
        'tabular-compact': {
            $type: 'typography',
            $value: {
                fontSize: { value: 12, unit: 'px' },
                lineHeight: { value: 16, unit: 'px' },
                letterSpacing: { value: 0, unit: 'px' },
                fontWeight: 'normal',
                fontFamily: '{font.family.base}',
                textTransform: 'initial',
                fontFeatureSettings: '"calt", "ss01", "ss04", "tnum", "zero"',
            },
        },
        'tabular-compact-strong': {
            $type: 'typography',
            $value: {
                fontSize: { value: 12, unit: 'px' },
                lineHeight: { value: 16, unit: 'px' },
                letterSpacing: { value: 0, unit: 'px' },
                fontWeight: 600,
                fontFamily: '{font.family.base}',
                textTransform: 'initial',
                fontFeatureSettings: '"calt", "ss01", "ss04", "tnum", "zero"',
            },
        },
        'italic-big': {
            $type: 'typography',
            $value: {
                fontStyle: 'italic',
                fontSize: { value: 16, unit: 'px' },
                lineHeight: { value: 24, unit: 'px' },
                letterSpacing: { value: -0.176, unit: 'px' },
                fontWeight: 'normal',
                fontFamily: '{font.family.base}',
                textTransform: 'initial',
                fontFeatureSettings: '"calt", "kern", "liga", "ss01", "ss04", "zero"',
            },
        },
        'italic-big-strong': {
            $type: 'typography',
            $value: {
                fontStyle: 'italic',
                fontSize: { value: 16, unit: 'px' },
                lineHeight: { value: 24, unit: 'px' },
                letterSpacing: { value: -0.176, unit: 'px' },
                fontWeight: 600,
                fontFamily: '{font.family.base}',
                textTransform: 'initial',
                fontFeatureSettings: '"calt", "kern", "liga", "ss01", "ss04", "zero"',
            },
        },
        'italic-normal': {
            $type: 'typography',
            $value: {
                fontStyle: 'italic',
                fontSize: { value: 14, unit: 'px' },
                lineHeight: { value: 20, unit: 'px' },
                letterSpacing: { value: -0.084, unit: 'px' },
                fontWeight: 'normal',
                fontFamily: '{font.family.base}',
                textTransform: 'initial',
                fontFeatureSettings: '"calt", "kern", "liga", "ss01", "ss04", "zero"',
            },
        },
        'italic-normal-strong': {
            $type: 'typography',
            $value: {
                fontStyle: 'italic',
                fontSize: { value: 14, unit: 'px' },
                lineHeight: { value: 20, unit: 'px' },
                letterSpacing: { value: -0.084, unit: 'px' },
                fontWeight: 600,
                fontFamily: '{font.family.base}',
                textTransform: 'initial',
                fontFeatureSettings: '"calt", "kern", "liga", "ss01", "ss04", "zero"',
            },
        },
        'italic-compact': {
            $type: 'typography',
            $value: {
                fontStyle: 'italic',
                fontSize: { value: 12, unit: 'px' },
                lineHeight: { value: 16, unit: 'px' },
                letterSpacing: { value: 0, unit: 'px' },
                fontWeight: 'normal',
                fontFamily: '{font.family.base}',
                textTransform: 'initial',
                fontFeatureSettings: '"calt", "kern", "liga", "ss01", "ss04", "zero"',
            },
        },
        'italic-compact-strong': {
            $type: 'typography',
            $value: {
                fontStyle: 'italic',
                fontSize: { value: 12, unit: 'px' },
                lineHeight: { value: 16, unit: 'px' },
                letterSpacing: { value: 0, unit: 'px' },
                fontWeight: 600,
                fontFamily: '{font.family.base}',
                textTransform: 'initial',
                fontFeatureSettings: '"calt", "kern", "liga", "ss01", "ss04", "zero"',
            },
        },
        'navbar-title': {
            $type: 'typography',
            $value: {
                fontSize: { value: 18, unit: 'px' },
                lineHeight: '{typography.title.lineHeight}',
                letterSpacing: '{typography.title.letterSpacing}',
                fontWeight: '{typography.title.fontWeight}',
                fontFamily: '{typography.title.fontFamily}',
                textTransform: '{typography.title.textTransform}',
                fontFeatureSettings: '{typography.title.fontFeatureSettings}',
            },
        },
    },
    // Per-locale overrides of single sub-properties, kept deliberately.
    //
    // zh-CN drops `strong` back to a normal weight at the two smallest sizes only: a bold 12px
    // hanzi carries enough strokes to close up into a blob, while the larger sizes read fine.
    // fa-IR swaps in Noto Naskh Arabic, since the Latin families carry no Arabic script at all.
    //
    // Nothing applies these automatically. They ship as their own variables (--kbq-zh-cn-*,
    // --kbq-fa-ir-*) for an app to use under a locale selector of its own — so they will look
    // unused from inside this repo. Unused is not unwanted: the DTCG migration already dropped
    // them once by mistake, and they had to be restored from the published v3.
    'zh-CN': {
        $type: 'fontWeight',
        'text-normal-strong': {
            'font-weight': {
                $value: 'normal',
            },
        },
        'mono-normal-strong': {
            'font-weight': {
                $value: 'normal',
            },
        },
        'text-compact-strong': {
            'font-weight': {
                $value: 'normal',
            },
        },
        'mono-compact-strong': {
            'font-weight': {
                $value: 'normal',
            },
        },
    },
    'fa-IR': {
        $type: 'fontFamily',
        'display-big': {
            'font-family': {
                $value: '{font.fa-IR.accent}',
            },
        },
        'display-normal': {
            'font-family': {
                $value: '{font.fa-IR.accent}',
            },
        },
        'display-compact': {
            'font-family': {
                $value: '{font.fa-IR.accent}',
            },
        },
        title: {
            'font-family': {
                $value: '{font.fa-IR.accent}',
            },
        },
        subheading: {
            'font-family': {
                $value: '{font.fa-IR.base}',
            },
        },
        'text-normal': {
            'font-family': {
                $value: '{font.fa-IR.base}',
            },
        },
        'tabular-normal': {
            'font-family': {
                $value: '{font.fa-IR.base}',
            },
        },
        'text-normal-strong': {
            'font-family': {
                $value: '{font.fa-IR.base}',
            },
        },
        'caps-normal': {
            'font-family': {
                $value: '{font.fa-IR.base}',
            },
        },
        'text-compact': {
            'font-family': {
                $value: '{font.fa-IR.base}',
            },
        },
        'tabular-compact': {
            'font-family': {
                $value: '{font.fa-IR.base}',
            },
        },
        'text-compact-strong': {
            'font-family': {
                $value: '{font.fa-IR.base}',
            },
        },
        'caps-compact': {
            'font-family': {
                $value: '{font.fa-IR.base}',
            },
        },
    },
}
