{
    typography: {
        headline: {
            $type: 'typography',
            $value: {
                fontSize: '28px',
                lineHeight: '32px',
                letterSpacing: 'normal',
                fontWeight: 700,
                fontFamily: '{font.family.accent}',
                textTransform: 'initial',
                fontFeatureSettings: '"calt", "kern", "liga"',
            },
        },
        title: {
            $type: 'typography',
            $value: {
                fontSize: '20px',
                lineHeight: '28px',
                letterSpacing: 'normal',
                fontWeight: 700,
                fontFamily: '{font.family.accent}',
                textTransform: 'initial',
                fontFeatureSettings: '"calt", "kern", "liga"',
            },
        },
        subheading: {
            $type: 'typography',
            $value: {
                fontSize: '18px',
                lineHeight: '26px',
                letterSpacing: 'normal',
                fontWeight: 600,
                fontFamily: '{font.family.accent}',
                textTransform: 'initial',
                fontFeatureSettings: '"calt", "kern", "liga"',
            },
        },
        'display-big': {
            $type: 'typography',
            $value: {
                fontSize: '57px',
                lineHeight: '64px',
                letterSpacing: 'normal',
                fontWeight: 400,
                fontFamily: '{font.family.accent}',
                textTransform: 'initial',
                fontFeatureSettings: '"calt", "kern", "liga"',
            },
        },
        'display-normal': {
            $type: 'typography',
            $value: {
                fontSize: '45px',
                lineHeight: '52px',
                letterSpacing: 'normal',
                fontWeight: 400,
                fontFamily: '{font.family.accent}',
                textTransform: 'initial',
                fontFeatureSettings: '"calt", "kern", "liga"',
            },
        },
        'display-compact': {
            $type: 'typography',
            $value: {
                fontSize: '36px',
                lineHeight: '44px',
                letterSpacing: 'normal',
                fontWeight: 400,
                fontFamily: '{font.family.accent}',
                textTransform: 'initial',
                fontFeatureSettings: '"calt", "kern", "liga"',
            },
        },
        'display-big-strong': {
            $type: 'typography',
            $value: {
                fontSize: '57px',
                lineHeight: '64px',
                letterSpacing: 'normal',
                fontWeight: 700,
                fontFamily: '{font.family.accent}',
                textTransform: 'initial',
                fontFeatureSettings: '"calt", "kern", "liga"',
            },
        },
        'display-normal-strong': {
            $type: 'typography',
            $value: {
                fontSize: '45px',
                lineHeight: '52px',
                letterSpacing: 'normal',
                fontWeight: 700,
                fontFamily: '{font.family.accent}',
                textTransform: 'initial',
                fontFeatureSettings: '"calt", "kern", "liga"',
            },
        },
        'display-compact-strong': {
            $type: 'typography',
            $value: {
                fontSize: '36px',
                lineHeight: '44px',
                letterSpacing: 'normal',
                fontWeight: 700,
                fontFamily: '{font.family.accent}',
                textTransform: 'initial',
                fontFeatureSettings: '"calt", "kern", "liga"',
            },
        },
        'text-big': {
            $type: 'typography',
            $value: {
                fontSize: '16px',
                lineHeight: '24px',
                letterSpacing: '-0.011em',
                fontWeight: 'normal',
                fontFamily: '{font.family.base}',
                textTransform: 'initial',
                fontFeatureSettings: '"calt", "kern", "liga", "ss01", "ss04", "zero"',
            },
        },
        'text-big-medium': {
            $type: 'typography',
            $value: {
                fontSize: '16px',
                lineHeight: '24px',
                letterSpacing: '-0.011em',
                fontWeight: 500,
                fontFamily: '{font.family.base}',
                textTransform: 'initial',
                fontFeatureSettings: '"calt", "kern", "liga", "ss01", "ss04", "zero"',
            },
        },
        'text-big-strong': {
            $type: 'typography',
            $value: {
                fontSize: '16px',
                lineHeight: '24px',
                letterSpacing: '-0.011em',
                fontWeight: 600,
                fontFamily: '{font.family.base}',
                textTransform: 'initial',
                fontFeatureSettings: '"calt", "kern", "liga", "ss01", "ss04", "zero"',
            },
        },
        'text-normal': {
            $type: 'typography',
            $value: {
                fontSize: '14px',
                lineHeight: '20px',
                letterSpacing: '-0.006em',
                fontWeight: 'normal',
                fontFamily: '{font.family.base}',
                textTransform: 'initial',
                fontFeatureSettings: '"calt", "kern", "liga", "ss01", "ss04", "zero"',
            },
        },
        'text-normal-medium': {
            $type: 'typography',
            $value: {
                fontSize: '14px',
                lineHeight: '20px',
                letterSpacing: '-0.006em',
                fontWeight: 500,
                fontFamily: '{font.family.base}',
                textTransform: 'initial',
                fontFeatureSettings: '"calt", "kern", "liga", "ss01", "ss04", "zero"',
            },
        },
        'text-normal-strong': {
            $type: 'typography',
            $value: {
                fontSize: '14px',
                lineHeight: '20px',
                letterSpacing: '-0.006em',
                fontWeight: 600,
                fontFamily: '{font.family.base}',
                textTransform: 'initial',
                fontFeatureSettings: '"calt", "kern", "liga", "ss01", "ss04", "zero"',
            },
        },
        'text-compact': {
            $type: 'typography',
            $value: {
                fontSize: '12px',
                lineHeight: '16px',
                letterSpacing: 'normal',
                fontWeight: 'normal',
                fontFamily: '{font.family.base}',
                textTransform: 'initial',
                fontFeatureSettings: '"calt", "kern", "liga", "ss01", "ss04", "zero"',
            },
        },
        'text-compact-medium': {
            $type: 'typography',
            $value: {
                fontSize: '12px',
                lineHeight: '16px',
                letterSpacing: 'normal',
                fontWeight: 500,
                fontFamily: '{font.family.base}',
                textTransform: 'initial',
                fontFeatureSettings: '"calt", "kern", "liga", "ss01", "ss04", "zero"',
            },
        },
        'text-compact-strong': {
            $type: 'typography',
            $value: {
                fontSize: '12px',
                lineHeight: '16px',
                letterSpacing: 'normal',
                fontWeight: 600,
                fontFamily: '{font.family.base}',
                textTransform: 'initial',
                fontFeatureSettings: '"calt", "kern", "liga", "ss01", "ss04", "zero"',
            },
        },
        'caps-big': {
            $type: 'typography',
            $value: {
                fontSize: '16px',
                lineHeight: '24px',
                letterSpacing: '0.08em',
                fontWeight: 400,
                fontFamily: '{font.family.base}',
                textTransform: 'uppercase',
                fontFeatureSettings: '"calt", "case", "kern", "liga", "ss01", "ss04", "zero"',
            },
        },
        'caps-big-strong': {
            $type: 'typography',
            $value: {
                fontSize: '16px',
                lineHeight: '24px',
                letterSpacing: '0.08em',
                fontWeight: 500,
                fontFamily: '{font.family.base}',
                textTransform: 'uppercase',
                fontFeatureSettings: '"calt", "case", "kern", "liga", "ss01", "ss04", "zero"',
            },
        },
        'caps-normal': {
            $type: 'typography',
            $value: {
                fontSize: '14px',
                lineHeight: '20px',
                letterSpacing: '0.08em',
                fontWeight: 'normal',
                fontFamily: '{font.family.base}',
                textTransform: 'uppercase',
                fontFeatureSettings: '"calt", "case", "kern", "liga", "ss01", "ss04", "zero"',
            },
        },
        'caps-normal-strong': {
            $type: 'typography',
            $value: {
                fontSize: '14px',
                lineHeight: '20px',
                letterSpacing: '0.08em',
                fontWeight: 500,
                fontFamily: '{font.family.base}',
                textTransform: 'uppercase',
                fontFeatureSettings: '"calt", "case", "kern", "liga", "ss01", "ss04", "zero"',
            },
        },
        'caps-compact': {
            $type: 'typography',
            $value: {
                fontSize: '12px',
                lineHeight: '16px',
                letterSpacing: '1px',
                fontWeight: 'normal',
                fontFamily: '{font.family.base}',
                textTransform: 'uppercase',
                fontFeatureSettings: '"calt", "case", "kern", "liga", "ss01", "ss04", "zero"',
            },
        },
        'caps-compact-strong': {
            $type: 'typography',
            $value: {
                fontSize: '12px',
                lineHeight: '16px',
                letterSpacing: '1px',
                fontWeight: 500,
                fontFamily: '{font.family.base}',
                textTransform: 'uppercase',
                fontFeatureSettings: '"calt", "case", "kern", "liga", "ss01", "ss04", "zero"',
            },
        },
        'mono-big': {
            $type: 'typography',
            $value: {
                fontSize: '16px',
                lineHeight: '24px',
                letterSpacing: 'normal',
                fontWeight: 'normal',
                fontFamily: '{font.family.mono}',
                textTransform: 'initial',
                fontFeatureSettings: 'initial',
            },
        },
        'mono-big-strong': {
            $type: 'typography',
            $value: {
                fontSize: '16px',
                lineHeight: '24px',
                letterSpacing: 'normal',
                fontWeight: 700,
                fontFamily: '{font.family.mono}',
                textTransform: 'initial',
                fontFeatureSettings: 'initial',
            },
        },
        'mono-normal': {
            $type: 'typography',
            $value: {
                fontSize: '14px',
                lineHeight: '20px',
                letterSpacing: 'normal',
                fontWeight: 'normal',
                fontFamily: '{font.family.mono}',
                textTransform: 'initial',
                fontFeatureSettings: 'initial',
            },
        },
        'mono-normal-medium': {
            $type: 'typography',
            $value: {
                fontSize: '14px',
                lineHeight: '20px',
                letterSpacing: 'normal',
                fontWeight: 600,
                fontFamily: '{font.family.mono}',
                textTransform: 'initial',
                fontFeatureSettings: 'initial',
            },
        },
        'mono-normal-strong': {
            $type: 'typography',
            $value: {
                fontSize: '14px',
                lineHeight: '20px',
                letterSpacing: 'normal',
                fontWeight: 700,
                fontFamily: '{font.family.mono}',
                textTransform: 'initial',
                fontFeatureSettings: 'initial',
            },
        },
        'mono-compact': {
            $type: 'typography',
            $value: {
                fontSize: '12px',
                lineHeight: '16px',
                letterSpacing: '0px',
                fontWeight: 'normal',
                fontFamily: '{font.family.mono}',
                textTransform: 'initial',
                fontFeatureSettings: 'initial',
            },
        },
        'mono-compact-strong': {
            $type: 'typography',
            $value: {
                fontSize: '12px',
                lineHeight: '16px',
                letterSpacing: '0px',
                fontWeight: 700,
                fontFamily: '{font.family.mono}',
                textTransform: 'initial',
                fontFeatureSettings: 'initial',
            },
        },
        'mono-codeblock': {
            $type: 'typography',
            $value: {
                fontSize: '14px',
                lineHeight: '20px',
                letterSpacing: 'normal',
                fontWeight: 'normal',
                fontFamily: '{font.family.mono}',
                textTransform: 'initial',
                fontFeatureSettings: 'initial',
            },
        },
        'tabular-big': {
            $type: 'typography',
            $value: {
                fontSize: '16px',
                lineHeight: '24px',
                letterSpacing: 'normal',
                fontWeight: 'normal',
                fontFamily: '{font.family.base}',
                textTransform: 'initial',
                fontFeatureSettings: '"calt", "ss01", "ss04", "tnum", "zero"',
            },
        },
        'tabular-big-strong': {
            $type: 'typography',
            $value: {
                fontSize: '16px',
                lineHeight: '24px',
                letterSpacing: 'normal',
                fontWeight: 600,
                fontFamily: '{font.family.base}',
                textTransform: 'initial',
                fontFeatureSettings: '"calt", "ss01", "ss04", "tnum", "zero"',
            },
        },
        'tabular-normal': {
            $type: 'typography',
            $value: {
                fontSize: '14px',
                lineHeight: '20px',
                letterSpacing: '-0.006em',
                fontWeight: 'normal',
                fontFamily: '{font.family.base}',
                textTransform: 'initial',
                fontFeatureSettings: '"calt", "ss01", "ss04", "tnum", "zero"',
            },
        },
        'tabular-normal-strong': {
            $type: 'typography',
            $value: {
                fontSize: '14px',
                lineHeight: '20px',
                letterSpacing: '-0.006em',
                fontWeight: 600,
                fontFamily: '{font.family.base}',
                textTransform: 'initial',
                fontFeatureSettings: '"calt", "ss01", "ss04", "tnum", "zero"',
            },
        },
        'tabular-compact': {
            $type: 'typography',
            $value: {
                fontSize: '12px',
                lineHeight: '16px',
                letterSpacing: 'normal',
                fontWeight: 'normal',
                fontFamily: '{font.family.base}',
                textTransform: 'initial',
                fontFeatureSettings: '"calt", "ss01", "ss04", "tnum", "zero"',
            },
        },
        'tabular-compact-strong': {
            $type: 'typography',
            $value: {
                fontSize: '12px',
                lineHeight: '16px',
                letterSpacing: 'normal',
                fontWeight: 600,
                fontFamily: '{font.family.base}',
                textTransform: 'initial',
                fontFeatureSettings: '"calt", "ss01", "ss04", "tnum", "zero"',
            },
        },
        'italic-big': {
            $type: 'typography',
            $value: {
                fontStyle: 'italic',
                fontSize: '16px',
                lineHeight: '24px',
                letterSpacing: '-0.011em',
                fontWeight: 'normal',
                fontFamily: '{font.family.base}',
                textTransform: 'initial',
                fontFeatureSettings: '"calt", "kern", "liga", "ss01", "ss04", "zero"',
            },
        },
        'italic-big-strong': {
            $type: 'typography',
            $value: {
                fontStyle: 'italic',
                fontSize: '16px',
                lineHeight: '24px',
                letterSpacing: '-0.011em',
                fontWeight: 600,
                fontFamily: '{font.family.base}',
                textTransform: 'initial',
                fontFeatureSettings: '"calt", "kern", "liga", "ss01", "ss04", "zero"',
            },
        },
        'italic-normal': {
            $type: 'typography',
            $value: {
                fontStyle: 'italic',
                fontSize: '14px',
                lineHeight: '20px',
                letterSpacing: '-0.006em',
                fontWeight: 'normal',
                fontFamily: '{font.family.base}',
                textTransform: 'initial',
                fontFeatureSettings: '"calt", "kern", "liga", "ss01", "ss04", "zero"',
            },
        },
        'italic-normal-strong': {
            $type: 'typography',
            $value: {
                fontStyle: 'italic',
                fontSize: '14px',
                lineHeight: '20px',
                letterSpacing: '-0.006em',
                fontWeight: 600,
                fontFamily: '{font.family.base}',
                textTransform: 'initial',
                fontFeatureSettings: '"calt", "kern", "liga", "ss01", "ss04", "zero"',
            },
        },
        'italic-compact': {
            $type: 'typography',
            $value: {
                fontStyle: 'italic',
                fontSize: '12px',
                lineHeight: '16px',
                letterSpacing: 'normal',
                fontWeight: 'normal',
                fontFamily: '{font.family.base}',
                textTransform: 'initial',
                fontFeatureSettings: '"calt", "kern", "liga", "ss01", "ss04", "zero"',
            },
        },
        'italic-compact-strong': {
            $type: 'typography',
            $value: {
                fontStyle: 'italic',
                fontSize: '12px',
                lineHeight: '16px',
                letterSpacing: 'normal',
                fontWeight: 600,
                fontFamily: '{font.family.base}',
                textTransform: 'initial',
                fontFeatureSettings: '"calt", "kern", "liga", "ss01", "ss04", "zero"',
            },
        },
        'navbar-title': {
            $type: 'typography',
            $value: {
                fontSize: '18px',
                lineHeight: '{typography.title.lineHeight}',
                letterSpacing: '{typography.title.letterSpacing}',
                fontWeight: '{typography.title.fontWeight}',
                fontFamily: '{typography.title.fontFamily}',
                textTransform: '{typography.title.textTransform}',
                fontFeatureSettings: '{typography.title.fontFeatureSettings}',
            },
        },
    },
    // Per-locale overrides of single sub-properties. They are not wired into the presets above —
    // they ship as their own variables (--kbq-zh-cn-*, --kbq-fa-ir-*) for an app to apply under
    // a locale selector of its own.
    'zh-CN': {
        $type: 'fontWeight',
        'text-normal-strong': {
            'font-weight': {
                $value: 'normal',
            },
        },
        'mono-normal-strong': {
            'font-weight': {
                $value: 'normal',
            },
        },
        'text-compact-strong': {
            'font-weight': {
                $value: 'normal',
            },
        },
        'mono-compact-strong': {
            'font-weight': {
                $value: 'normal',
            },
        },
    },
    'fa-IR': {
        $type: 'fontFamily',
        'display-big': {
            'font-family': {
                $value: '{font.fa-IR.accent}',
            },
        },
        'display-normal': {
            'font-family': {
                $value: '{font.fa-IR.accent}',
            },
        },
        'display-compact': {
            'font-family': {
                $value: '{font.fa-IR.accent}',
            },
        },
        title: {
            'font-family': {
                $value: '{font.fa-IR.accent}',
            },
        },
        subheading: {
            'font-family': {
                $value: '{font.fa-IR.base}',
            },
        },
        'text-normal': {
            'font-family': {
                $value: '{font.fa-IR.base}',
            },
        },
        'tabular-normal': {
            'font-family': {
                $value: '{font.fa-IR.base}',
            },
        },
        'text-normal-strong': {
            'font-family': {
                $value: '{font.fa-IR.base}',
            },
        },
        'caps-normal': {
            'font-family': {
                $value: '{font.fa-IR.base}',
            },
        },
        'text-compact': {
            'font-family': {
                $value: '{font.fa-IR.base}',
            },
        },
        'tabular-compact': {
            'font-family': {
                $value: '{font.fa-IR.base}',
            },
        },
        'text-compact-strong': {
            'font-family': {
                $value: '{font.fa-IR.base}',
            },
        },
        'caps-compact': {
            'font-family': {
                $value: '{font.fa-IR.base}',
            },
        },
    },
}
