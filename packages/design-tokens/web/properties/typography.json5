{
    typography: {
        headline: {
            $type: 'typography',
            $value: {
                fontSize: { value: 28, unit: 'px' },
                lineHeight: { value: 32, unit: 'px' },
                letterSpacing: { value: 0, unit: 'px' },
                fontWeight: 700,
                fontFamily: '{font.family.accent}',
                textTransform: 'initial',
                fontFeatureSettings: '"calt", "kern", "liga"',
            },
        },
        title: {
            $type: 'typography',
            $value: {
                fontSize: { value: 20, unit: 'px' },
                lineHeight: { value: 28, unit: 'px' },
                letterSpacing: { value: 0, unit: 'px' },
                fontWeight: 700,
                fontFamily: '{font.family.accent}',
                textTransform: 'initial',
                fontFeatureSettings: '"calt", "kern", "liga"',
            },
        },
        subheading: {
            $type: 'typography',
            $value: {
                fontSize: { value: 18, unit: 'px' },
                lineHeight: { value: 26, unit: 'px' },
                letterSpacing: { value: 0, unit: 'px' },
                fontWeight: 600,
                fontFamily: '{font.family.accent}',
                textTransform: 'initial',
                fontFeatureSettings: '"calt", "kern", "liga"',
            },
        },
        'display-big': {
            $type: 'typography',
            $value: {
                fontSize: { value: 57, unit: 'px' },
                lineHeight: { value: 64, unit: 'px' },
                letterSpacing: { value: 0, unit: 'px' },
                fontWeight: 400,
                fontFamily: '{font.family.accent}',
                textTransform: 'initial',
                fontFeatureSettings: '"calt", "kern", "liga"',
            },
        },
        'display-normal': {
            $type: 'typography',
            $value: {
                fontSize: { value: 45, unit: 'px' },
                lineHeight: { value: 52, unit: 'px' },
                letterSpacing: { value: 0, unit: 'px' },
                fontWeight: 400,
                fontFamily: '{font.family.accent}',
                textTransform: 'initial',
                fontFeatureSettings: '"calt", "kern", "liga"',
            },
        },
        'display-compact': {
            $type: 'typography',
            $value: {
                fontSize: { value: 36, unit: 'px' },
                lineHeight: { value: 44, unit: 'px' },
                letterSpacing: { value: 0, unit: 'px' },
                fontWeight: 400,
                fontFamily: '{font.family.accent}',
                textTransform: 'initial',
                fontFeatureSettings: '"calt", "kern", "liga"',
            },
        },
        'display-big-strong': {
            $type: 'typography',
            $value: {
                fontSize: { value: 57, unit: 'px' },
                lineHeight: { value: 64, unit: 'px' },
                letterSpacing: { value: 0, unit: 'px' },
                fontWeight: 700,
                fontFamily: '{font.family.accent}',
                textTransform: 'initial',
                fontFeatureSettings: '"calt", "kern", "liga"',
            },
        },
        'display-normal-strong': {
            $type: 'typography',
            $value: {
                fontSize: { value: 45, unit: 'px' },
                lineHeight: { value: 52, unit: 'px' },
                letterSpacing: { value: 0, unit: 'px' },
                fontWeight: 700,
                fontFamily: '{font.family.accent}',
                textTransform: 'initial',
                fontFeatureSettings: '"calt", "kern", "liga"',
            },
        },
        'display-compact-strong': {
            $type: 'typography',
            $value: {
                fontSize: { value: 36, unit: 'px' },
                lineHeight: { value: 44, unit: 'px' },
                letterSpacing: { value: 0, unit: 'px' },
                fontWeight: 700,
                fontFamily: '{font.family.accent}',
                textTransform: 'initial',
                fontFeatureSettings: '"calt", "kern", "liga"',
            },
        },
        'text-big': {
            $type: 'typography',
            $value: {
                fontSize: { value: 16, unit: 'px' },
                lineHeight: { value: 24, unit: 'px' },
                letterSpacing: { value: -0.176, unit: 'px' },
                fontWeight: 'normal',
                fontFamily: '{font.family.base}',
                textTransform: 'initial',
                fontFeatureSettings: '"calt", "kern", "liga", "ss01", "ss04", "zero"',
            },
        },
        'text-big-medium': {
            $type: 'typography',
            $value: {
                fontSize: { value: 16, unit: 'px' },
                lineHeight: { value: 24, unit: 'px' },
                letterSpacing: { value: -0.176, unit: 'px' },
                fontWeight: 500,
